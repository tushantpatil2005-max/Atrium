    def _collection_by_name(self, name: str) -> dict:
        for c in self.collections.values():
            if c.name == name:
                return asdict(c)
        raise KeyError(name)

    # ----- RBAC -----

    def get_user(self, user_id: str) -> User:
        if user_id not in self.users:
            raise KeyError(f"Unknown user: {user_id}")
        return self.users[user_id]

    def can_read_collection(self, user_id: str, collection_id: str) -> bool:
        user = self.get_user(user_id)
        col = self.collections.get(collection_id)
        if not col:
            return False
        if user.role == "admin":
            return True
        if collection_id not in user.collection_ids and user.role != "admin":
            # still allow if role rank meets min_role and user is in tenant grants
            pass
        return ROLE_RANK.get(user.role, 0) >= ROLE_RANK.get(col.min_role, 99)

    def allowed_collections(self, user_id: str) -> set[str]:
        return {cid for cid in self.collections if self.can_read_collection(user_id, cid)}

    def require_role(self, user_id: str, min_role: str):
        user = self.get_user(user_id)
        if ROLE_RANK.get(user.role, 0) < ROLE_RANK.get(min_role, 99):
            raise PermissionError(f"Role {user.role} cannot perform action requiring {min_role}")

    # ----- collections & uploads -----

    def create_collection(
        self, user_id: str, name: str, description: str, min_role: str = "member"
    ) -> dict:
        self.require_role(user_id, "manager")
        if min_role not in ROLE_RANK:
            raise ValueError("Invalid min_role")
        cid = f"col_{uuid.uuid4().hex[:8]}"
        col = Collection(cid, name, description, min_role, user_id)
        self.collections[cid] = col
        for u in self.users.values():
            if cid not in u.collection_ids:
                u.collection_ids.append(cid)
        return asdict(col)

    def upload_document(
        self,
        user_id: str,
        collection_id: str,
        title: str,
        text: str,
        tags: Optional[list[str]] = None,
    ) -> dict:
        self.require_role(user_id, "member")
        if collection_id not in self.collections:
            raise KeyError("Unknown collection")
        if not self.can_read_collection(user_id, collection_id):
            # writers must also be able to access the collection
            raise PermissionError("No access to collection")
        # Finance restricted: only manager+ can upload when min_role is manager
        col = self.collections[collection_id]
        if ROLE_RANK[self.get_user(user_id).role] < ROLE_RANK[col.min_role]:
            raise PermissionError("Insufficient role for this collection")

        doc = Document(
            id=f"doc_{uuid.uuid4().hex[:8]}",
            collection_id=collection_id,
            title=title.strip() or "Untitled",
            text=text.strip(),
            uploaded_by=user_id,
            created_ms=int(time.time() * 1000),
            content_hash=content_hash(text),
            tags=tags or [],
        )
        self.documents[doc.id] = doc
        self.index.rebuild(list(self.documents.values()))
        return {
            "id": doc.id,
            "collection_id": doc.collection_id,
            "title": doc.title,
            "tags": doc.tags,
            "content_hash": doc.content_hash,
            "chars": len(doc.text),
            "uploaded_by": doc.uploaded_by,
        }

    def list_documents(self, user_id: str, collection_id: Optional[str] = None) -> list[dict]:
        allowed = self.allowed_collections(user_id)
        out = []
        for d in self.documents.values():
            if d.collection_id not in allowed:
                continue
            if collection_id and d.collection_id != collection_id:
                continue
            out.append(
                {
                    "id": d.id,
                    "title": d.title,
                    "collection_id": d.collection_id,
                    "tags": d.tags,
                    "uploaded_by": d.uploaded_by,
                    "chars": len(d.text),
                }
            )
        return out

    # ----- retrieval & chat -----

    def search(self, user_id: str, query: str, k: int = 5) -> dict:
        t0 = time.time()
        allowed = self.allowed_collections(user_id)
        hits = self.index.search(query, allowed, k=k)
        return {
            "query": query,
            "user_id": user_id,
            "hits": hits,
            "collections_searched": sorted(allowed),
            "timings_ms": round((time.time() - t0) * 1000, 2),
        }

    def chat(
        self,
        user_id: str,
        message: str,
        session_id: Optional[str] = None,
        k: int = 4,
    ) -> dict:
        t0 = time.time()
        session_id = session_id or f"sess_{uuid.uuid4().hex[:8]}"
        allowed = self.allowed_collections(user_id)
        hits = self.index.search(message, allowed, k=k)

        citations = []
        for i, h in enumerate(hits[:3], 1):
            citations.append(
                {
                    "id": i,
                    "doc_id": h["doc_id"],
                    "title": h["title"],
                    "collection_id": h["collection_id"],
                    "excerpt": re.sub(r"\s+", " ", h["text"])[:220],
                    "score": h["score"],
                }
            )

        if not hits or coverage(message, " ".join(h["text"] for h in hits[:3])) < 0.15:
            answer = (
                "No accessible documents fully cover this question. "
                "Try another query or ask a manager to grant collection access."
            )
            confidence = 0.2
        else:
            sentences = []
            for h in hits[:2]:
                for sent in re.split(r"(?<=[.!?])\s+", h["text"]):
                    if len(sent.strip()) >= 40 and coverage(message, sent) >= 0.1:
                        sentences.append(sent.strip())
            if not sentences:
                sentences = [hits[0]["text"][:240]]
            answer = " ".join(sentences[:3])
            if citations:
                answer = f"{answer} [{citations[0]['id']}]"
            confidence = round(min(0.95, 0.4 + hits[0]["score"] * 0.4), 2)

        answer = strip_machine_labels(answer)
        turn = {
            "role": "user",
            "content": message,
            "user_id": user_id,
        }
        reply = {
            "role": "assistant",
            "content": answer,
            "citations": citations,
        }
        self.chat_history[session_id].extend([turn, reply])
        self.chat_history[session_id] = self.chat_history[session_id][-30:]

        return {
            "session_id": session_id,
            "user_id": user_id,
            "message": message,
            "answer": answer,
            "confidence": confidence,
            "citations": citations,
            "structured": {
                "action": "answer" if citations else "insufficient_access_or_evidence",
                "citation_ids": [c["id"] for c in citations],
                "collections_used": sorted({c["collection_id"] for c in citations}),
            },
            "history_turns": len(self.chat_history[session_id]),
            "timings_ms": round((time.time() - t0) * 1000, 2),
        }

    # ----- agents -----

    def agent_report(
        self,
        user_id: str,
        topic: str,
        report_type: str = "brief",
    ) -> dict:
        """Report agent: retrieve evidence the user can access and structure a business report."""
        t0 = time.time()
        self.require_role(user_id, "member")
        search = self.search(user_id, topic, k=6)
        hits = search["hits"]

        sections = []
        sources = []
        for i, h in enumerate(hits[:5], 1):
            sources.append(
                {
                    "id": i,
                    "doc_id": h["doc_id"],
                    "title": h["title"],
                    "collection_id": h["collection_id"],
                }
            )
            sections.append(
                {
                    "heading": h["title"],
                    "body": strip_machine_labels(h["text"][:400]),
                    "citation_id": i,
                }
            )

        if not sections:
            summary = "Insufficient accessible evidence to produce a report on this topic."
            status = "empty"
        else:
            summary = strip_machine_labels(
                f"Report on '{topic}' based on {len(sections)} accessible sources "
                f"across collections {sorted({s['collection_id'] for s in sources})}."
            )
            status = "complete"

        report = {
            "id": f"rpt_{uuid.uuid4().hex[:8]}",
            "type": report_type,
            "topic": topic,
            "status": status,
            "summary": summary,
            "sections": sections,
            "sources": sources,
            "generated_for": user_id,
            "agent": "report_agent",
            "structured": {
                "section_count": len(sections),
                "source_ids": [s["doc_id"] for s in sources],
            },
            "timings_ms": round((time.time() - t0) * 1000, 2),
        }
        self.reports[report["id"]] = report
        return report

    def agent_workflow(
        self,
        user_id: str,
        objective: str,
    ) -> dict:
        """
        Workflow agent: plan steps (search → synthesize → optional escalate)
        using retrieval under RBAC.
        """
        t0 = time.time()
        self.require_role(user_id, "member")
        steps = []

        steps.append(
            {
                "id": "w1",
                "name": "permission_scope",
                "status": "done",
                "detail": f"Collections in scope: {sorted(self.allowed_collections(user_id))}",
            }
        )

        search = self.search(user_id, objective, k=4)
        steps.append(
            {
                "id": "w2",
                "name": "retrieve",
                "status": "done",
                "detail": f"Retrieved {len(search['hits'])} chunks for objective.",
                "hit_ids": [h["doc_id"] for h in search["hits"]],
            }
        )

        report = self.agent_report(user_id, objective, report_type="workflow_brief")
        steps.append(
            {
                "id": "w3",
                "name": "synthesize_report",
                "status": "done",
                "detail": f"Report {report['id']} status={report['status']}",
                "report_id": report["id"],
            }
        )

        needs_human = report["status"] == "empty" or len(search["hits"]) < 2
        if needs_human:
            steps.append(
                {
                    "id": "w4",
                    "name": "escalate",
                    "status": "pending_human",
                    "detail": "Low evidence; manager review recommended.",
                }
            )
            wf_status = "needs_review"
        else:
            steps.append(
                {
                    "id": "w4",
                    "name": "complete",
                    "status": "done",
                    "detail": "Evidence threshold met; workflow finished.",
                }
            )
            wf_status = "complete"

        workflow = {
            "id": f"wf_{uuid.uuid4().hex[:8]}",
            "objective": objective,
            "status": wf_status,
            "agent": "workflow_agent",
            "steps": steps,
            "report_id": report["id"],
            "structured": {
                "step_count": len(steps),
                "needs_human": needs_human,
                "collections": sorted(self.allowed_collections(user_id)),
            },
            "owner": user_id,
            "timings_ms": round((time.time() - t0) * 1000, 2),
        }
        self.workflows[workflow["id"]] = workflow
        return workflow

    # ----- evaluation -----

    def evaluate(self) -> dict:
        """Retrieval + RBAC evaluation metrics on seeded docs."""
        # Retrieval: known queries should surface expected titles for admin
        probes = [
            ("on-call severity-1 page", "On-call runbook"),
            ("production deploy pull request", "Service deployment policy"),
            ("expense 500 director approval", "Expense policy FY2026"),
            ("paid time off days", "Employee handbook leave"),
        ]
        hits_at_1 = 0
        hits_at_3 = 0
        for query, expected_title in probes:
            result = self.search("u_admin", query, k=3)
            titles = [h["title"] for h in result["hits"]]
            if titles and titles[0] == expected_title:
                hits_at_1 += 1
            if expected_title in titles:
                hits_at_3 += 1
        n = len(probes)
        retrieval = {
            "n": n,
            "top1_accuracy": round(hits_at_1 / n, 3),
            "top3_accuracy": round(hits_at_3 / n, 3),
        }

        # RBAC: viewer must not see finance board cash; manager may
        view_search = self.search("u_view", "cash on hand runway Q3", k=5)
        mgr_search = self.search("u_mgr", "cash on hand runway Q3", k=5)
        view_titles = {h["title"] for h in view_search["hits"]}
        mgr_titles = {h["title"] for h in mgr_search["hits"]}
        rbac = {
            "viewer_blocked_finance_board": "Q3 board cash summary" not in view_titles,
            "manager_sees_finance_board": "Q3 board cash summary" in mgr_titles,
            "viewer_collections": sorted(self.allowed_collections("u_view")),
            "manager_collections": sorted(self.allowed_collections("u_mgr")),
        }

        # Chat structure
        chat = self.chat("u_mem", "How do production deploys work?", session_id="eval_sess")
        chat_ok = bool(chat.get("structured")) and "answer" in chat

        return {
            "retrieval": retrieval,
            "rbac": rbac,
            "chat_structured": chat_ok,
            "documents": len(self.documents),
            "collections": len(self.collections),
            "chunks": len(self.index.chunks),
        }

    def stats(self) -> dict:
        return {
            "app": APP_NAME,
            "users": len(self.users),
            "collections": len(self.collections),
            "documents": len(self.documents),
            "chunks": len(self.index.chunks),
        }


# ---------------------------------------------------------------------------
# Self-check
# ---------------------------------------------------------------------------


def self_check() -> list[str]:
    notes: list[str] = []
    ws = KnowledgeWorkspace()
    assert ws.stats()["documents"] >= 4

    # Upload
    eng = ws._collection_by_name("Engineering")
    up = ws.upload_document(
        "u_mem",
        eng["id"],
        "API versioning note",
        "Public APIs use URL versioning. Deprecated versions receive 90 days of support.",
        tags=["api"],
    )
    assert up["id"].startswith("doc_")
    notes.append(f"upload={up['id']}")

    # RAG search
    s = ws.search("u_mem", "feature flags production deploy", k=3)
    assert s["hits"], "expected retrieval hits"
    notes.append(f"search hits={len(s['hits'])} top={s['hits'][0]['title']}")

    # Chat + structured
    c = ws.chat("u_mem", "What is required for a production deploy?", session_id="s1")
    assert c["answer"] and c["structured"]
    assert c["citations"]
    notes.append(f"chat cites={len(c['citations'])} conf={c['confidence']}")

    # Multi-user RBAC
    fin_q = "cash on hand Q3 runway"
    view_hits = {h["title"] for h in ws.search("u_view", fin_q)["hits"]}
    mgr_hits = {h["title"] for h in ws.search("u_mgr", fin_q)["hits"]}
    assert "Q3 board cash summary" not in view_hits
    assert "Q3 board cash summary" in mgr_hits
    notes.append("rbac viewer blocked finance board; manager allowed")

    # Viewer can still read People handbook
    leave = ws.search("u_view", "paid time off parental leave")
    assert any("handbook" in h["title"].lower() or "leave" in h["title"].lower() for h in leave["hits"])

    # Report agent
    report = ws.agent_report("u_mgr", "expense approval thresholds")
    assert report["status"] in ("complete", "empty")
    assert "structured" in report
    notes.append(f"report sections={len(report['sections'])}")

    # Workflow agent
    wf = ws.agent_workflow("u_mem", "incident severity-1 response timeline")
    assert len(wf["steps"]) >= 3
    assert wf["structured"]["step_count"] >= 3
    notes.append(f"workflow status={wf['status']} steps={len(wf['steps'])}")

    # Evaluation metrics
    metrics = ws.evaluate()
    assert metrics["retrieval"]["top3_accuracy"] >= 0.5
    assert metrics["rbac"]["viewer_blocked_finance_board"] is True
    assert metrics["rbac"]["manager_sees_finance_board"] is True
    notes.append(
        f"eval top1={metrics['retrieval']['top1_accuracy']} top3={metrics['retrieval']['top3_accuracy']}"
    )

    # Permission errors
    try:
        ws.upload_document("u_view", eng["id"], "x", "y")
        raise AssertionError("viewer should not upload")
    except PermissionError:
        notes.append("viewer upload denied")

    blob = json.dumps(c) + json.dumps(report)
    assert not re.search(r"(?i)ai[- ]generated|powered by ai|as an ai", blob)
    return notes


# ---------------------------------------------------------------------------
# FastAPI
# ---------------------------------------------------------------------------

if HAS_FASTAPI:
    app = FastAPI(title="Atrium — Enterprise Knowledge Workspace", version="1.0.0")
    _ws = KnowledgeWorkspace()

    class UploadBody(BaseModel):
        user_id: str
        collection_id: str
        title: str
        text: str
        tags: list[str] = []

    class SearchBody(BaseModel):
        user_id: str
        query: str
        k: int = 5

    class ChatBody(BaseModel):
        user_id: str
        message: str
        session_id: Optional[str] = None

    class ReportBody(BaseModel):
        user_id: str
        topic: str
        report_type: str = "brief"

    class WorkflowBody(BaseModel):
        user_id: str
        objective: str

    def _err(ex: Exception):
        if isinstance(ex, PermissionError):
            raise HTTPException(status_code=403, detail=str(ex)) from ex
        if isinstance(ex, KeyError):
            raise HTTPException(status_code=404, detail=str(ex)) from ex
        raise HTTPException(status_code=400, detail=str(ex)) from ex

    @app.get("/health")
    def health():
        return {"ok": True, **_ws.stats()}

    @app.get("/collections")
    def collections(user_id: str):
        allowed = _ws.allowed_collections(user_id)
        return [asdict(c) for cid, c in _ws.collections.items() if cid in allowed]

    @app.get("/documents")
    def documents(user_id: str, collection_id: Optional[str] = None):
        return _ws.list_documents(user_id, collection_id)

    @app.post("/upload")
    def upload(body: UploadBody):
        try:
            return _ws.upload_document(
                body.user_id, body.collection_id, body.title, body.text, body.tags
            )
        except Exception as ex:  # noqa: BLE001
            _err(ex)

    @app.post("/search")
    def search(body: SearchBody):
        try:
            return _ws.search(body.user_id, body.query, body.k)
        except Exception as ex:  # noqa: BLE001
            _err(ex)

    @app.post("/chat")
    def chat(body: ChatBody):
        try:
            return _ws.chat(body.user_id, body.message, body.session_id)
        except Exception as ex:  # noqa: BLE001
            _err(ex)

    @app.post("/agents/report")
    def report(body: ReportBody):
        try:
            return _ws.agent_report(body.user_id, body.topic, body.report_type)
        except Exception as ex:  # noqa: BLE001
            _err(ex)

    @app.post("/agents/workflow")
    def workflow(body: WorkflowBody):
        try:
            return _ws.agent_workflow(body.user_id, body.objective)
        except Exception as ex:  # noqa: BLE001
            _err(ex)

    @app.get("/evaluate")
    def evaluate():
        return _ws.evaluate()


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------


def main():
    parser = argparse.ArgumentParser(description="Enterprise AI Knowledge Workspace")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--evaluate", action="store_true")
    parser.add_argument("--user", default="u_mem")
    parser.add_argument("--search", type=str)
    parser.add_argument("--chat", type=str)
    parser.add_argument("--report", type=str)
    parser.add_argument("--workflow", type=str)
    parser.add_argument("--serve", action="store_true")
    parser.add_argument("--host", default="0.0.0.0")
    parser.add_argument("--port", type=int, default=8000)
    args = parser.parse_args()

    if args.check:
        notes = self_check()
        print("PASS")
        for n in notes:
            print(n)
        return

    ws = KnowledgeWorkspace()

    if args.evaluate:
        print(json.dumps(ws.evaluate(), indent=2))
        return

    if args.serve:
        if not HAS_FASTAPI:
            raise SystemExit("Install fastapi uvicorn: pip install fastapi uvicorn")
        import uvicorn

        uvicorn.run(app, host=args.host, port=args.port)
        return

    if args.search:
        print(json.dumps(ws.search(args.user, args.search), indent=2))
        return
    if args.chat:
        print(json.dumps(ws.chat(args.user, args.chat), indent=2))
        return
    if args.report:
        print(json.dumps(ws.agent_report(args.user, args.report), indent=2))
        return
    if args.workflow:
        print(json.dumps(ws.agent_workflow(args.user, args.workflow), indent=2))
        return

    parser.print_help()


if __name__ == "__main__":
    main()
